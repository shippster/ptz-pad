{
  "name": "ptz-pad",
  "productName": "PTZ Pad",
  "version": "1.13.1",
  "description": "Drive PTZ cameras with an Xbox controller. VISCA, NDI, PTZOptics, Panasonic, Axis and custom HTTP, with auto-tracking from NDI, RTSP or SRT video.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "bridge": "node ptz-bridge.js",
    "helper": "node helper/ptz-pad-mcp.js",
    "postinstall": "node tools/get-models.js",
    "web": "node tools/build-web.js",
    "bump": "node tools/bump.js",
    "notes": "node tools/release-notes.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.ptzpad.controller",
    "productName": "PTZ Pad",
    "files": [
      "main.js",
      "preload.js",
      "bridge-core.js",
      "ndi-core.js",
      "video-worker.js",
      "video-core.js",
      "bridge-server.js",
      "web/**",
      "app/**",
      "tracker/**",
      "models/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "PTZ-Pad-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PTZ-Pad-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "PTZ Pad finds NDI cameras and sends them pan, tilt, zoom and preset commands on your local network.",
        "NSBluetoothAlwaysUsageDescription": "PTZ Pad uses Bluetooth game controllers to drive your cameras.",
        "NSBonjourServices": [
          "_ndi._tcp"
        ],
        "NSCameraUsageDescription": "PTZ Pad shows the picture from USB, USB-C and built-in cameras and follows the speaker in it."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video"
    },
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "koffi": "^2.9.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "ptzpadInstall": "1.4.0",
  "homepage": "https://shippster.github.io/ptz-pad/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shippster/ptz-pad.git"
  }
}
